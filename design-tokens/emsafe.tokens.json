  "font": {
    "heading": "Barlow Semi Condensed",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "type": {
    "display":   { "font": "heading", "size": 44, "line": 48, "weight": 600, "tracking": -0.4 },
    "h1":        { "font": "heading", "size": 32, "line": 38, "weight": 600, "tracking": -0.2 },
    "h2":        { "font": "heading", "size": 24, "line": 30, "weight": 600, "tracking": 0 },
    "h3":        { "font": "heading", "size": 20, "line": 26, "weight": 600, "tracking": 0 },
    "h4":        { "font": "heading", "size": 17, "line": 22, "weight": 600, "tracking": 0.1 },
    "eyebrow":   { "font": "heading", "size": 12, "line": 16, "weight": 600, "tracking": 1.4 },
    "label":     { "font": "body",    "size": 13, "line": 18, "weight": 500, "tracking": 0 },
    "body-lg":   { "font": "body",    "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "body":      { "font": "body",    "size": 14, "line": 21, "weight": 400, "tracking": 0 },
    "body-sm":   { "font": "body",    "size": 13, "line": 19, "weight": 400, "tracking": 0 },
    "caption":   { "font": "body",    "size": 12, "line": 16, "weight": 400, "tracking": 0.1 },
    "metric-xl": { "font": "mono",    "size": 44, "line": 48, "weight": 500, "tracking": -1.2 },
    "metric-lg": { "font": "mono",    "size": 30, "line": 34, "weight": 500, "tracking": -0.6 },
    "metric-md": { "font": "mono",    "size": 20, "line": 26, "weight": 500, "tracking": -0.2 },
    "mono":      { "font": "mono",    "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "mono-sm":   { "font": "mono",    "size": 11, "line": 14, "weight": 500, "tracking": 0.5 }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64 },
  "radius": { "none": 0, "xs": 2, "sm": 4, "md": 6, "lg": 10, "pill": 999 },
  "border": { "hairline": 1, "strong": 2, "rail": 3 },
  "size": {
    "control-sm": 32,
    "control-md": 40,
    "control-lg": 48,
    "touch-min": 48,
    "icon-sm": 16,
    "icon-md": 20,
    "icon-lg": 24,
    "nav-rail": 248,
    "nav-rail-collapsed": 68,
    "topbar": 60,
    "bottom-nav": 68,
    "content-max": 1440,
    "form-max": 760
  },
  "breakpoint": { "sm": 600, "md": 900, "lg": 1200, "xl": 1440 },
  "motion": {
    "duration": { "instant": 80, "fast": 120, "base": 180, "slow": 260 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.4, 0, 1, 1]
    }
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(14,17,21,0.06)",
    "2": "0 8px 24px -8px rgba(14,17,21,0.20)",
    "3": "0 24px 48px -12px rgba(14,17,21,0.32)"
  },
  "exposure": {
    "$description": "Semántica fija de estados: verde seguro, amarillo advertencia, rojo crítico/excedido. Nunca solo color: siempre etiqueta + icono.",
    "safe": "safe",
    "caution": "warning",
    "warning": "warning",
    "danger": "danger",
    "exceeded": "danger"
  }
}
